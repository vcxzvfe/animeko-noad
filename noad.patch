api.animeko.org 的 /v2/subjects/{id}/recommendations 会混入 subjectId=-1、带外链 uri 的广告项, 与首页 RecommendationRepository 的既有过滤规则保持一致。同时禁用更新检查, 防止自编译版被官方包覆盖。
---
 .../domain/episode/GetSubjectRecommendationFlowUseCase.kt    | 5 ++++-
 .../src/commonMain/kotlin/ui/update/UpdateChecker.kt         | 5 +++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/app/shared/app-data/src/commonMain/kotlin/domain/episode/GetSubjectRecommendationFlowUseCase.kt b/app/shared/app-data/src/commonMain/kotlin/domain/episode/GetSubjectRecommendationFlowUseCase.kt
index c9a0f9f..58f5aff 100644
--- a/app/shared/app-data/src/commonMain/kotlin/domain/episode/GetSubjectRecommendationFlowUseCase.kt
+++ b/app/shared/app-data/src/commonMain/kotlin/domain/episode/GetSubjectRecommendationFlowUseCase.kt
@@ -32,7 +32,10 @@ fun interface GetSubjectRecommendationUseCase : UseCase {
 
 class GetSubjectRecommendationUseCaseImpl(private val service: SubjectService) : GetSubjectRecommendationUseCase {
     override suspend fun invoke(subjectId: Int): List<SubjectRecommendation> {
-        return service.getSubjectRecommendations(subjectId, 15).map {
+        return service.getSubjectRecommendations(subjectId, 15)
+            // 服务器会在推荐流中混入广告 (subjectId <= 0 且带外链 uri), 与首页 RecommendationRepository 一致地过滤掉
+            .filter { it.uri == null && (it.subjectId ?: 0) > 0 }
+            .map {
             SubjectRecommendation(
                 subjectId = it.subjectId,
                 name = it.subjectName,
diff --git a/app/shared/ui-settings/src/commonMain/kotlin/ui/update/UpdateChecker.kt b/app/shared/ui-settings/src/commonMain/kotlin/ui/update/UpdateChecker.kt
index 6c07a74..51a62b5 100644
--- a/app/shared/ui-settings/src/commonMain/kotlin/ui/update/UpdateChecker.kt
+++ b/app/shared/ui-settings/src/commonMain/kotlin/ui/update/UpdateChecker.kt
@@ -29,6 +29,9 @@ import me.him188.ani.utils.logging.logger
 import me.him188.ani.utils.platform.currentPlatform
 
 class UpdateChecker {
+    // 自编译版本标记: true 时 checkLatestVersion 恒返回 "无新版本"
+    private val selfBuiltDisableUpdateCheck = true
+
     /**
      * 检查是否有更新的版本. 返回最新版本的信息, 或者 `null` 表示没有新版本.
      */
@@ -36,6 +39,8 @@ class UpdateChecker {
         releaseClass: ReleaseClass,
         currentVersion: String = currentAniBuildConfig.versionName,
     ): NewVersion? {
+        // 自编译版本: 禁用更新检查, 避免升级回官方包 (更新请从源码重新构建)
+        if (selfBuiltDisableUpdateCheck) return null
         HttpClient(getPlatformKtorEngine()) {
             expectSuccess = true
         }.use { client ->
